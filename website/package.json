{
  "name": "clockbound-website",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Public-facing product landing site for ClockBound v3.",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "fetch-stats": "node scripts/fetch-stats.mjs",
    "prepare-assets": "npm run copy-assets && npm run fetch-stats",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "vite-react-ssg build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
